venv/
__pycache__/
*.pyc
.env
.git/
.claude/

# raw source PDFs/HTML are ingestion inputs, not needed at runtime.
# data/qdrant_db is deliberately excluded even though it may exist locally -
# it gets rebuilt fresh from chunks.jsonl at image-build time (see
# Dockerfile) rather than copying a possibly-stale local copy in.
data/raw/**/*.pdf
data/raw/**/*.html
data/qdrant_db/

observability/*.db
observability/call_log.jsonl
